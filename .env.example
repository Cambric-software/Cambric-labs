# Cambric Labs — environment configuration template
#
# Copy this file to `.env` and fill in real values for your deployment.
# NEVER commit a real `.env` file. Real credentials must be provided at runtime
# via environment variables (or a non-tracked `.env` loaded by your runner).
#
# Cambric Labs is local-first: Supabase integration is OPTIONAL. If these
# variables are unset, the backend runs in local-only mode without cloud sync.

# Supabase project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=

# Supabase publishable (anon) key — public/RLS-scoped. Safe for backend use.
SUPABASE_ANON_KEY=

# Supabase service-role key — bypasses RLS, full DB access.
# SERVER-SIDE ONLY. NEVER put this in frontend, client, Android, or public code.
SUPABASE_SERVICE_ROLE_KEY=
